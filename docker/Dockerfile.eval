# robocode-eval: offline image for scoring saved approaches on a cluster.
#
# Holds the locked runtime dependencies, robocode and kinder at one revision, and
# kinder's MuJoCo scene assets, so evaluation needs no network and no writable install.
# No agent CLI, no sandbox tooling. Build with docker/build_eval_sif.sh, which supplies
# the scene assets as the named build context `scenes`.

FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        libgl1 \
        libegl1 \
        libglib2.0-0 \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /usr/local/bin/uv

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

WORKDIR /opt/robocode

# Dependencies first, so code changes do not reinstall them.
COPY pyproject.toml uv.lock .python-version README.md ./
COPY third-party/kindergarden third-party/kindergarden
RUN uv sync --frozen --no-dev --no-install-project

COPY src src
COPY experiments experiments
COPY third-party/ss-pybullet third-party/ss-pybullet
RUN uv sync --frozen --no-dev

COPY --from=scenes . third-party/kindergarden/src/kinder/envs/dynamic3d/models/assets/mimiclabs_scenes/

ARG ROBOCODE_REVISION=unknown
RUN echo "${ROBOCODE_REVISION}" > REVISION && chmod -R a+rX /opt

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    MUJOCO_GL=disable \
    DISABLE_AUTO_DYNAMIC3D_SCENES_DOWNLOAD=1 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1
