# CINECA Leonardo, DCGP (CPU) partition: 112 cores and 512 GB per node, billed per
# reserved core. Copy to leonardo.env (untracked) and fill in the <...> values.
REEVAL_CONTAINER=singularity
REEVAL_SIF=$WORK/<user>/reeval/robocode-eval.sif
REEVAL_STORE=$WORK/<user>/reeval/store
REEVAL_OUT=$WORK/<user>/reeval/out
REEVAL_LOGS=$WORK/<user>/reeval/logs
REEVAL_EVAL_SEED=<team evaluation seed>

REEVAL_PARTITION=dcgp_usr_prod
REEVAL_ACCOUNT=<project account with DCGP budget>
# Empty uses the partition's default QOS. Smoke tests: REEVAL_QOS=dcgp_qos_dbg with
# REEVAL_TIME=00:30:00 and REEVAL_NUM_SHARDS=1.
REEVAL_QOS=
REEVAL_TIME=24:00:00
REEVAL_CPUS=56
REEVAL_NUM_SHARDS=20
REEVAL_MAX_CONCURRENT=20
