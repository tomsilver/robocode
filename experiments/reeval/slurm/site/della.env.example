# Princeton Della CPU nodes. The QOS follows --time; keep it above 61 minutes or jobs
# land in the two-job test QOS. Pin one CPU type: the policy budget is wall-clock time.
# Copy to della.env (untracked) and fill in the <...> values.
REEVAL_CONTAINER=apptainer
REEVAL_SIF=/scratch/gpfs/<group>/<netid>/reeval/robocode-eval.sif
REEVAL_STORE=/scratch/gpfs/<group>/<netid>/reeval/store
REEVAL_OUT=/scratch/gpfs/<group>/<netid>/reeval/out
REEVAL_LOGS=/scratch/gpfs/<group>/<netid>/reeval/logs
REEVAL_EVAL_SEED=<team evaluation seed>

REEVAL_PARTITION=
REEVAL_ACCOUNT=
REEVAL_QOS=
REEVAL_TIME=23:59:00
REEVAL_CPUS=32
REEVAL_NUM_SHARDS=40
REEVAL_MAX_CONCURRENT=40
REEVAL_SBATCH_EXTRA="--constraint=intel --mem-per-cpu=3G"
